#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <14 15>; // left home row: S + D
            bindings = <&kp ESC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Position order matches ghkb.dtsi's default_transform map exactly:
            // row0/1/2: left outer..inner, right inner..outer (12 each)
            // row3: left near/home/far/[enc], right [enc]/far/home/near (8)
            bindings = <
&kp TAB    &kp Q &kp W &kp E      &kp R      &kp T        &kp Y      &kp U      &kp I      &kp O   &kp P    &kp BSPC
&kp LCTRL  &kp A &kp S &hm LALT D &hm LSHFT F &kp G       &kp H      &hm RCTRL J &hm RGUI K &kp L  &kp SEMI &kp SQT
&kp LSHFT  &kp Z &kp X &kp C      &kp V      &kp B        &kp N      &kp M      &kp COMMA  &kp DOT &kp FSLH &kp RSHFT
                        &kp LGUI   &mo 1      &kp SPACE    &kp C_MUTE &kp C_MUTE &kp RET    &mo 1   &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        nav_sym_layer {
            bindings = <
&kp ESC  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS  &kp STAR  &kp LPAR &kp RPAR  &kp BSPC
&trans   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp MINUS &kp EQUAL
&trans   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0       &kp HOME  &kp PG_DN &kp PG_UP &kp END  &kp BSLH  &trans
                   &trans   &trans   &trans       &kp C_VOL_DN &kp C_VOL_UP &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
