#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &ghkb_layout;
    };

    ghkb_layout: ghkb_layout {
        compatible = "zmk,physical-layout";
        display-name = "GHKB";
        transform = <&default_transform>;
        // `keys` (x/y positions for ZMK Studio) intentionally omitted
        // for v0.1 - optional per zmk,physical-layout.yaml, not
        // required to build.
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        // Left: outer pinky ring middle index inner | inner index middle ring pinky outer :Right
        //                    near  home  far  [enc]  | [enc]  far  home  near
        //
        // Thumb/encoder RC() column values come from borrowed main-matrix
        // column nets (near=P18/middle, home=P15/index, far=P14/inner,
        // encoder-push=P19/ring - see kscan0 col-gpios below), so they
        // don't ascend in electrical order the way the main matrix does.
        // Sequence here is instead chosen to match true physical
        // left-to-right position per pcb/ergogen/config.yaml's anchors:
        // thumbs zone lists near/home/far in that (left-to-right) order,
        // and the encoder is anchored at thumbs_far + [1.1kx, *] (i.e.
        // further right than "far", toward the center gap). Not yet
        // confirmed against a rendered layout or real hardware (GYE-275).
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                            RC(3,3) RC(3,4) RC(3,5) RC(3,2)   RC(3,9) RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // P5 top
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // P6 home
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // P7 bottom
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // P8 thumb
            ;
        // col-gpios is intentionally left undefined here; each side
        // wires its own physical column order in ghkb_<side>.overlay.
    };

    // EC11 rotary encoder: A/C are direct GPIOs (not part of the kscan
    // matrix); the encoder's pushbutton (S1/S2) reuses the ring x thumb
    // matrix cell and is handled in the transform above as RC(3,2)/RC(3,9).
    encoder0: encoder0 {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 2 GPIO_PULL_UP>;  // P2
        b-gpios = <&pro_micro 3 GPIO_PULL_UP>;  // P3 ("C" in config.yaml)
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <20>;
    };
};
