# KiCad
*.kicad_prl
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
_autosave-*
fp-info-cache

# ergogen
pcb/ergogen/output/
node_modules/

# FreeCAD
*.FCBak
*.FCStd1

# ZMK / firmware build artifacts
firmware/tinygo/build/

# ZMK west workspace (topdir is firmware/zmk/ per config_path in
# .github/workflows/build.yml). `west update` materializes module
# directories here whose exact set depends on manifest groups
# (zephyr/, modules/, zmk/, optional/, tools/, bootloader/, bin/, .west/, ...).
# Ignore everything under firmware/zmk/ except our own tracked config.
firmware/zmk/*
!firmware/zmk/config/
!firmware/zmk/build.yaml

# Autorouter intermediates
*.dsn
*.ses
*.rules

# Python
__pycache__/
.venv/

# macOS
.DS_Store
